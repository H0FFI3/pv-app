# --- AlphaESS-Zugang -------------------------------------------------------
ALPHAESS_APP_ID=
ALPHAESS_APP_SECRET=
# Nur bei mehreren Anlagen nötig:
ALPHAESS_SYSTEM_SN=

# --- Standort --------------------------------------------------------------
LATITUDE=
LONGITUDE=
# IANA-Name, z. B. Europe/Berlin
TIMEZONE=

# --- Dach und Modulfelder --------------------------------------------------
SURFACE_TILT_DEG=
MODULE_MODEL=
MODULE_POWER_WP=
# Anteil, z. B. 0.21 für 21 %
MODULE_EFFICIENCY=
MODULE_NMOT_C=
MODULE_BIFACIAL=
# Anteil pro Kelvin, z. B. -0.0030 für -0,30 %/K
POWER_TEMPERATURE_COEFFICIENT=
# Anteil, z. B. 0.14 für 14 %
SYSTEM_LOSS_FRACTION=
MODULES_EAST=
AZIMUTH_EAST_DEG=
MODULES_WEST=
AZIMUTH_WEST_DEG=

# --- Wechselrichtermodell und Erfassungszeitraum -----------------------------
NOMINAL_INVERTER_EFFICIENCY=
# Mindestabstand zwischen AlphaESS-Aufrufen in Sekunden (leer = 10)
API_REQUEST_INTERVAL_SECONDS=
# Erster zu erfassender Tag, JJJJ-MM-TT
DATA_START_DATE=

# --- Optional: Erfassung ---------------------------------------------------
# Höchstens so viele fehlende Tage pro Start nachholen (leer = 14, max. 92)
BACKFILL_MAX_DAYS=
# Wetterquelle: auto (Archiv, fehlende Tage aus Forecast-API), archive oder forecast (leer = auto)
WEATHER_SOURCE=
# Pfad der erzeugten HTML-Datei (leer = neben der EXE, sonst %LOCALAPPDATA%\PV-Tagesbericht)
REPORT_PATH=

# --- Optional: Modellgenauigkeit (alles leer/false = Verhalten wie bisher) ----
# Einfallswinkel-Modifikator (ASHRAE) für die direkte Strahlung
IAM_ENABLED=
IAM_B=
# Bodenreflexion (leer = 0.25)
ALBEDO=
# Horizontprofil von PVGIS berücksichtigen (Verschattung durch Umgebung)
HORIZON_ENABLED=
# Rückseitengewinn bifazialer Module als Anteil (z. B. 0.05); wirkt nur mit MODULE_BIFACIAL=true
BIFACIALITY_GAIN=
